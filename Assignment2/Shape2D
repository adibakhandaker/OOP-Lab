public class Shape2D {
    int length;
    int width;

    Shape2D(int l, int w) {
        length = l;
        width = w;
    }
    double Area()
    {
        return length * width;
    }
    double Perimeter()
    {
        return 2*(length+width);
    }
    void Display()
    {
        System.out.println("Shape 2d:");
        System.out.println("Length: " + length);
        System.out.println("Width: " + width);
        System.out.println("perimeter: " + Perimeter());
    }

}
