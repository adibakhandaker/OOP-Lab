//how many armstrong numbers from m to n;
package beginnerjava;
import java.util.Scanner;
public class Armstrong {
    public static void main(String[] args) {
        int m,n,num,temp,r,sum=0;
        Scanner input=new Scanner (System.in);
        m=input.nextInt();
        n=input.nextInt();
        for (int i = m; i <= n; i++) {
            temp=i;
            while (temp != 0) {
            r = temp % 10;
            sum = sum +r* r*r;
            temp = temp / 10;
        }
         if (sum==i) {
             System.out.println(i + " ");
        }
         sum=0;
        }
    }
 
